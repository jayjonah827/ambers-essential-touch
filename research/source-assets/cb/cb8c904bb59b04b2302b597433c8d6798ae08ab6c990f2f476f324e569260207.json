{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "design_handoff_glass_website/source_html/**",
              "ui_kits/dashboard/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: DM Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|onClick|href|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, onClick, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|gold)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|gold|key|ref|className|style|children)$/]",
        "message": "<EvidenceBadge> doesn't accept that prop. Declared props: children, gold."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|assetBase|src|style|key|ref|className|style|children)$/]",
        "message": "<Glyph> doesn't accept that prop. Declared props: name, size, assetBase, src, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glyph'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:eye|clock|compass|coin|graph|hand|origin|pyramid)$/]",
        "message": "<Glyph> name must be one of 'eye' | 'clock' | 'compass' | 'coin' | 'graph' | 'hand' | 'origin' | 'pyramid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:thick|color|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: thick, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|children|key|ref|className|style|children)$/]",
        "message": "<StateTag> doesn't accept that prop. Declared props: type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateTag'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:subordinated|structural|dominant|outer)$/]",
        "message": "<StateTag> type must be one of 'subordinated' | 'structural' | 'dominant' | 'outer'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
